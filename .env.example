# Run npm run configure to create .env with fresh local keys.
YAHOO_EMAIL=
YAHOO_APP_PW=
YAHOO_CONNECTOR_TOKEN=
YAHOO_STATE_KEY=
YAHOO_READ_ONLY=true
YAHOO_PORT=8935
YAHOO_POLL_INTERVAL_MS=60000
# Optional; relative paths are resolved from the repository directory.
# YAHOO_STATE_PATH=runtime/state.sqlite
# Optional, for npm run tunnel only:
# CONTROL_PLANE_TUNNEL_ID=
# CONTROL_PLANE_API_KEY=
# TUNNEL_CLIENT_PATH=tunnel-client
